# Database Configuration (used by the Go backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SOURCE_NAME=lab_source
DB_TARGET_NAME=lab_target

# PostgreSQL container (used by Docker Compose).
# Keep POSTGRES_USER/POSTGRES_PASSWORD in sync with DB_USER/DB_PASSWORD above
# so the backend and the database agree on credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development
APP_URL=https://godata.josebianco.local

# CORS (comma-separated allowed origins; defaults to APP_URL + localhost:5173)
CORS_ALLOWED_ORIGINS=https://godata.josebianco.local,http://localhost:5173,http://127.0.0.1:5173

# JWT/Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
# Legacy expiry (hours); kept for backwards compatibility.
JWT_EXPIRY_HOURS=24
# Access token lifetime (Go duration, e.g. 15m, 1h). Default: 15m.
JWT_ACCESS_TTL=15m
# Refresh token lifetime (Go duration, e.g. 168h, 7d is not supported). Default: 168h.
JWT_REFRESH_TTL=168h

# Bootstrap Admin
BOOTSTRAP_ADMIN_EMAIL=root@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_123!

# Logging
LOG_LEVEL=info
LOG_PATH=logs/app.log

# Secure ID encryption key (32 bytes, base64 or hex)
SECURE_ID_KEY=
